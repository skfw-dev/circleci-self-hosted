# Environment of the runner container. HOLDS A SECRET - keep it mode 600 and
# out of version control. ./setup.sh writes the real runner.env.
# Manual setup: cp runner.env.example runner.env && chmod 600 runner.env

# Label for THIS runner instance, shown in CircleCI under Runners.
# It is not the namespace or the resource class.
# Allowed: letters, digits and . ( ) - _
CIRCLECI_RUNNER_NAME=vps-runner-01

# Resource class token. Shown once when the resource class is created; it
# decides which <namespace>/<resource-class> this runner serves.
CIRCLECI_RUNNER_API_AUTH_TOKEN='paste-your-resource-class-token-here'

# continuous  = keep polling for jobs (default)
# single-task = exit after one job; Docker restarts the container process
CIRCLECI_RUNNER_MODE=continuous

# Longest a single job may run (units: h, m, s).
CIRCLECI_RUNNER_MAX_RUN_TIME=5h

# Remove the job's working directory after each job.
CIRCLECI_RUNNER_CLEANUP_WORK_DIR=true

# debug | info | warn | error
CIRCLECI_RUNNER_LOGGING_LEVEL=info
# color | text | json | none
CIRCLECI_RUNNER_LOGGING_FORMAT=text

# Set to true when RUNNER_REPLICAS > 1 so every replica gets a unique name.
RUNNER_NAME_APPEND_HOSTNAME=false

# CircleCI Server only. Leave unset on circleci.com.
# CIRCLECI_RUNNER_API_URL=https://circleci.example.com
