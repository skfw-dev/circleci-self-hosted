# Compose-level settings (not secret). ./setup.sh writes the real .env.
# Manual setup: cp .env.example .env

# Tag of circleci/runner-agent to build on. "machine-3" is a moving tag.
RUNNER_IMAGE_TAG=machine-3

# Extra apt packages baked into the image, space separated, in double quotes.
EXTRA_APT_PACKAGES=""

# Number of runner containers. Each one runs one job at a time.
RUNNER_REPLICAS=1

# Per-container limits. 0 = no limit. CPUs may be fractional (1.5).
# Memory takes a unit: 512M, 4G.
RUNNER_CPUS=0
RUNNER_MEMORY=0
RUNNER_PIDS_LIMIT=4096

# How long `docker stop` waits for the active job before killing it.
RUNNER_STOP_GRACE_PERIOD=10m

# Image build target: "runner", or "runner-dood" together with the overlay.
RUNNER_BUILD_TARGET=runner

# Docker-out-of-Docker (read the warning in compose.dood.yaml first):
# COMPOSE_PATH_SEPARATOR=:
# COMPOSE_FILE=compose.yaml:compose.dood.yaml
# RUNNER_BUILD_TARGET=runner-dood
# DOCKER_GID=999
